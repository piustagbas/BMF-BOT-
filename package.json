{
  "name": "memecoinbot",
  "private": true,
  "version": "0.1.0",
  "description": "Solana meme-coin AI trading analyzer (paper-first, mobile)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@memecoinbot/api",
    "dev:mobile": "turbo run start --filter=@memecoinbot/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @memecoinbot/db generate",
    "db:migrate": "echo \"mongoose — no migrations; collections create on first write\"",
    "db:push": "echo \"mongoose — no schema push needed\"",
    "redis:start": "node scripts/start-redis.mjs"
  },
  "pnpm": {
    "neverBuiltDependencies": ["redis-memory-server"]
  },
  "devDependencies": {
    "redis-memory-server": "^0.17.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
