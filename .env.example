# === App ===
NODE_ENV=development
APP_PORT=3001
# Hosted (Render) uses PORT automatically. Local stays 3001.
# Local API root (used by server-side helpers)
API_URL=http://localhost:3001
# Public URL for phones / Expo Go — set to your ngrok HTTPS URL (LinguaAICall pattern)
# Example: SERVER_URL=https://abc123.ngrok-free.dev
SERVER_URL=http://localhost:3001

# === Database (MongoDB — replaces Postgres/Prisma) ===
MONGODB_URI=mongodb://127.0.0.1:27017/memecoinbot

# === Redis (optional) ===
REDIS_URL=redis://localhost:6379

# === Auth (JWT — same idea as LinguaAICall) ===
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Sign-In (optional — Expo Go browser OAuth)
# Create OAuth "Web" client in Google Cloud Console
# Authorized redirect URI:
#   {SERVER_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apple Sign-In (optional — iOS; Expo Go accepts host.exp.Exponent)
APPLE_CLIENT_ID=

# === Solana ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === Market data (server-only — never expose to mobile) ===
DEXSCREENER_BASE_URL=https://api.dexscreener.com
JUPITER_QUOTE_API_URL=https://lite-api.jup.ag/swap/v1
# Axiom: no official public API key. See README "Axiom keys".
# Optional placeholders if you later wire a proxy / unofficial tokens:
AXIOM_API_URL=
AXIOM_API_KEY=
AXIOM_ACCESS_TOKEN=
AXIOM_REFRESH_TOKEN=
TOKEN_SECURITY_API_URL=https://api.rugcheck.xyz/v1
TOKEN_SECURITY_API_KEY=

# === Trading defaults (safe) ===
DEFAULT_TRADING_MODE=SIGNAL_ONLY
AUTO_TRADING_ENABLED=false
KILL_SWITCH=true
AXIOM_REQUIRED_FOR_AUTO_TRADING=true
PAPER_BALANCE=1000
REAL_TRADING_BROADCAST=false
AUTO_EXECUTION_MODE=dry_run

# === Risk defaults ===
SAFETY_MIN=80
SIGNAL_MIN=80
RISK_PER_TRADE_PCT=1
TP1_PCT=30
TP1_SELL_PCT=30
TP2_PCT=60
TP2_SELL_PCT=40
REMAINING_PCT=30

# === Notifications (optional Telegram) ===
# 1) @BotFather → /newbot → copy token
# 2) Message your bot once
# 3) curl http://localhost:3001/api/notifications/telegram/discover-chat
# 4) Set TELEGRAM_CHAT_ID from the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === WhatsApp (optional — Meta Cloud API or Twilio) ===
# GET /api/notifications/whatsapp/setup for full steps
WHATSAPP_PROVIDER=meta
# Meta:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Optional approved template for cold outbound (else free-form needs 24h user reply window)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# Twilio alternative:
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Email / Gmail (optional) ===
# GET /api/notifications/email/setup for steps (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
# SMTP_FROM=

# === Redis (notification queue) ===
REDIS_URL=redis://127.0.0.1:6379
# Start with: pnpm redis:start  (or brew/docker redis)

GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# === Smart-money discovery (optional extra trade feeds; GeckoTerminal is the default) ===
# SMART_MONEY_DISCOVERY_ENABLED=true
# SMART_MONEY_MAX_TOKENS_PER_CYCLE=8
# HELIUS_API_KEY=
# HELIUS_API_URL=https://api.helius.xyz
# BIRDEYE_API_KEY=
# BIRDEYE_API_URL=https://public-api.birdeye.so
# VERIFIED_SMART_WALLETS=
# Extra known infra/exchange wallets to always exclude (comma-separated)
# SMART_MONEY_INFRA_WALLETS=

# === Bet Bot (football) ===
# TheSportsDB is used automatically (no key) for upcoming + live top-league matches.
# Live scores: TheSportsDB livescore + football-data LIVE + optional Odds API scores.
# Not LiveScore.com / Forebet scrapes (no official API).
# Optional: football-data.org token for extra fixtures + team form
# FOOTBALL_DATA_TOKEN=
# Optional: The Odds API — guide prices from UK/EU books (NOT Bet9ja/SportyBet).
# You still type the slip on Bet9ja or SportyBet.
# ODDS_API_KEY=
# ODDS_API_REGIONS=uk,eu
# ODDS_API_BOOKMAKER=   (optional; if empty, the feed's best book is used as a guide)
# BET_BOOK_1_LABEL=Bet9ja
# BET_BOOK_2_LABEL=SportyBet
# Optional: ChatGPT analyses both teams BEFORE the bot picks a market.
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Compatible OpenAI-style hosts also work (Groq, OpenRouter) via OPENAI_BASE_URL.

# === Mobile (Expo) — copy into apps/mobile/.env or export when starting Expo ===
# For Expo Go on a phone, use ngrok:
#   ngrok http 3001
# then:
# EXPO_PUBLIC_API_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api
