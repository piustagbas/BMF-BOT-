# Copy to .env or export when starting Expo
# Local simulator / web:
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Expo Go on a physical phone (LinguaAICall / ngrok pattern):
# 1. pnpm dev:api
# 2. ngrok http 3001
# 3. Set:
# EXPO_PUBLIC_API_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev/api

# Hosted API (Render free) — use this for the phone build:
# EXPO_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com/api
